{
  "manifest_version": 3,
  "name": "베베픽 PC 백그라운드 보조 감시",
  "version": "0.1.0",
  "description": "공개 주문·재고 상태를 확인하고 동의한 v2.4 주문 페이지에 재확인 신호를 전달",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://bebepick.me/*",
    "https://eqytdtxemjlygnobhiio.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bebepick.me/live*",
        "https://bebepick.me/plus*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "베베픽 PC 백그라운드 감시"
  }
}
